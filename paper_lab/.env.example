# An OpenAI API key is required for the real TradingAgents analyst run.
# Set it in your shell or a private deployment environment. Never commit it.
OPENAI_API_KEY=
# Optional: the existing Railway spelling is accepted. The new project has its
# own environment; set this variable there if you want Alpha Vantage data.
# ALPHAVANTAGE_API_KEY=
TA_PAPER_DATA_DIR=./data
TA_PAPER_TICKERS=SPY,QQQ,IWM,XLK,XLF
# TradingAgents v0.5.1 defaults to GPT-6 Sol and Luna. Override if needed.
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
